@page
@{
    ViewData["Title"] = "All Users (Admin)";
}

<div class="page-header">
    <h1>All Users</h1>
    <a class="btn" href="/Admin/CreateUser">+ Create New User</a>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="mb-0 mt-0" style="margin: 0;">Show role:</label>
    <!-- filled by JS with the dynamic role list -->
    <select id="userListRole" class="w-auto">
        <option>Instructor</option>
        <option>Student</option>
    </select>
</div>

<div class="border-glow-card">
    <table>
        <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th></tr>
        </thead>
        <tbody id="usersTableBody"></tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/admin/users.js"></script>
}
