    <a class="btn" href="/Admin/CreateCourse">+ Create New Course</a>
</div>

<input type="text" id="courseSearch" class="mb-3" placeholder="Search courses..." />

<!-- JS fills this div with one BorderGlow card per course -->
<div id="coursesList"></div>

@section Scripts {
    <script src="~/js/admin/courses.js"></script>
}
