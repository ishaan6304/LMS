@page
@{
    ViewData["Title"] = "My Learning";
}

@section Styles {
    <style>
        .border-glow-card {
            position: relative;
            padding: 20px;
            overflow: visible; /* or hidden if you don't want the image sticking out */
        }

        .thumimg {
            position: absolute;
            top: 15px; /* change as needed */
            right: 15px; /* or left: 15px */

            width: 200px;
            height: 190px;
            object-fit: cover;
            border-radius: 10px;
            border: 2px solid #fff;
            background: #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,.3);
        }

        /* mobile: thumbnail flows under the text instead of floating over it */
        @@media (max-width: 640px) {
            .border-glow-card {
                padding: 16px;
            }

            .thumimg {
                position: static;
                display: block;
                width: 100%;
                height: auto;
                margin-top: 12px;
            }
        }
    </style>
}

<h1 id="welcomeText"></h1>

<div class="stats-row">
    <div class="border-glow-card stat-card">
        <div class="stat-number" id="statEnrolled">-</div>
        <div class="stat-label">Enrolled Courses</div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">My Courses</h2>
    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-sm" href="/Student/Catalog">Browse All Courses</a>
        <a class="btn btn-sm" href="/Student/Qna">My Q&amp;A</a>
    </div>
</div>

<!-- JS renders BorderGlow course cards in here -->
<div id="courseCards"></div>

@section Scripts {
    <script src="~/js/student/dashboard.js"></script>
}
