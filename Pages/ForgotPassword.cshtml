@page
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page">

    <div class="auth-brand">
        <h1>📚 LMS</h1>
        <p>We will email you a reset link.</p>
    </div>

    <form id="forgotForm" class="auth-card">
        <h2>Forgot password</h2>

        <div id="pageAlert" class="d-none"></div>

        <label>Email</label>
        <input type="email" id="forgotEmail" placeholder="Your email" required />

        <button type="submit" class="w-100">Send reset link</button>

        <a href="/" class="auth-link">&larr; Back to login</a>
    </form>

</div>

@section Scripts {
    <script src="~/js/forgot-password.js"></script>
}
