@page
@{
    ViewData["Title"] = "Instructor Dashboard";
}

<h1 id="welcomeText"></h1>

<div class="stats-row">
    <div class="border-glow-card stat-card">
        <div class="stat-number" id="statMyCourses">-</div>
        <div class="stat-label">My Courses</div>
    </div>
    <div class="border-glow-card stat-card">
        <div class="stat-number" id="statMyStudents">-</div>
        <div class="stat-label">Students Enrolled</div>
    </div>
</div>

<h2>Services</h2>

<div class="services-grid mb-4">
    <a class="border-glow-card service-card" href="/Instructor/Courses">
        <div class="service-emoji">📚</div>
        <h3>My Courses</h3>
        <p>Browse, edit and disable your courses</p>
    </a>
    <a class="border-glow-card service-card" href="/Instructor/CreateCourse">
        <div class="service-emoji">➕</div>
        <h3>Create Course</h3>
        <p>Add a new course with chapters and content</p>
    </a>
    <a class="border-glow-card service-card" href="/Instructor/Requests">
        <div class="service-emoji">📨</div>
        <h3>Enrollment Requests</h3>
        <p>Approve or reject student requests</p>
    </a>
    <a class="border-glow-card service-card" href="/Instructor/Qna">
        <div class="service-emoji">❓</div>
        <h3>Q&amp;A</h3>
        <p>Answer questions from your students</p>
    </a>
    <a class="border-glow-card service-card" href="/Instructor/Assign">
        <div class="service-emoji">🎯</div>
        <h3>Assign Courses</h3>
        <p>Enroll students into your courses</p>
    </a>
    <a class="border-glow-card service-card" href="/Profile">
        <div class="service-emoji">👤</div>
        <h3>My Profile</h3>
        <p>Update your details and password</p>
    </a>
</div>

<h2>Enrollment per Course</h2>

<div class="border-glow-card mb-4">
    <table>
        <thead>
            <tr><th>Course</th><th>Enrolled Students</th></tr>
        </thead>
        <tbody id="statsTableBody"></tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/instructor/dashboard.js"></script>
}
