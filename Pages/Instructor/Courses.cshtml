@page
@{
    ViewData["Title"] = "My Courses (Instructor)";
}

<div class="page-header">
    <h1>My Courses</h1>
    <a class="btn" href="/Instructor/CreateCourse">+ Create New Course</a>
</div>

<input type="text" id="courseSearch" class="mb-3" placeholder="Search my courses..." />

<!-- JS fills this div with one BorderGlow card per course -->
<div id="coursesList"></div>

@section Scripts {
    <script src="~/js/instructor/courses.js"></script>
}
